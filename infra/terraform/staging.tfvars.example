# Copy to staging.tfvars (git-ignored) and fill in.
environment      = "staging"
aws_region       = "<region>"
domain_name      = "<staging host name>"
platform_api_url = "https://<staging platform api-gateway>"

# Route 53 zone of the domain. Leave empty if DNS is elsewhere, and set certificate_arn instead.
hosted_zone_id  = ""
certificate_arn = ""

# An account can have only one GitHub OIDC provider. Set this if it already exists.
github_oidc_provider_arn = ""

alarm_email = ""
