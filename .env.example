# ---------------------------------------------------------------------------
# Bhutan NDI hosted page — build-time settings
# The page is a static export (DL-018). Run-time settings (platform URL, language
# switch) live in config.json, deployed per environment and never part of the build.
# Local dev reads config.dev.json.
# ---------------------------------------------------------------------------

# Extra connect-src sources in the CSP meta tag (space-separated). Default: https:
# For a local http platform: CSP_CONNECT_SRC=http://localhost:5000
# CSP_CONNECT_SRC=

# --- Public (baked into the client bundle at build time) --------------------
NEXT_PUBLIC_SUPPORT_EMAIL=ndifeedback@bhutanndi.bt
NEXT_PUBLIC_SUPPORT_PHONE=1199
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/search?q=bhutan%20ndi
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/search?term=bhutan%20ndi
# "Watch video guide" link (hidden when empty).
NEXT_PUBLIC_VIDEO_GUIDE_URL=
