# ---------------------------------------------------------------------------
# Bhutan NDI hosted page — environment
# Copy to .env.local for development. The page holds no secrets: it only reads
# public, read-only platform endpoints (HVP-SD §5.3).
# ---------------------------------------------------------------------------

# Public base URL of this page (https in production), e.g. https://id.bhutanndi.com (DL-012).
APP_BASE_URL=http://localhost:3000

# Platform api-gateway base URL serving GET /verification/hosted/:hostedId and /status.
# The browser calls it directly, so it is also added to the CSP connect-src, and the
# platform must allow this page's origin (CORS). Read at run time.
# Local ngotag-platform: http://localhost:5000
PLATFORM_API_URL=http://localhost:5000

# Design QA gallery at /preview (demo data). Defaults to on outside production.
# ENABLE_PREVIEW=false

LOG_LEVEL=debug

# --- Language (read at run time; restart the server to apply) --------------
# Show the EN / Dzongkha switch. When false, every page is in English.
ENABLE_LANGUAGE_TOGGLE=true

# --- Public (baked into the client bundle at build time) --------------------
NEXT_PUBLIC_SUPPORT_EMAIL=ndifeedback@bhutanndi.bt
NEXT_PUBLIC_SUPPORT_PHONE=1199
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/search?q=bhutan%20ndi
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/search?term=bhutan%20ndi
# "Watch video guide" link (hidden when empty).
NEXT_PUBLIC_VIDEO_GUIDE_URL=
