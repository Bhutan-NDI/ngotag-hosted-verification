# ---------------------------------------------------------------------------
# Bhutan NDI hosted page — environment
# Copy to .env.local for development. In production, inject these from your
# secret manager. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public base URL of this hosted page (https in production).
APP_BASE_URL=http://localhost:3000

# Mock NDI: no calls to NDI, fake proof requests, dev panel + /api/dev/*.
# Defaults to true in development and false in production.
NDI_MOCK=true
# Only for a staging box that must run mock in production mode.
# NDI_MOCK_ALLOW_IN_PRODUCTION=false

# Design QA gallery at /preview (defaults to the NDI_MOCK value).
# ENABLE_PREVIEW=false

# Redis — required in production (sessions, pub/sub for live updates, rate limits).
# REDIS_URL=redis://localhost:6379

LOG_LEVEL=debug

# --- NDI credentials (from the NDI developer portal) ------------------------
NDI_CLIENT_ID=
NDI_CLIENT_SECRET=

# --- NDI endpoints (staging defaults — confirm against current NDI docs) ----
NDI_AUTH_URL=https://staging.bhutanndi.com/authentication/v1/authenticate
NDI_VERIFIER_URL=https://demo-client.bhutanndi.com/verifier/v1/proof-request
NDI_WEBHOOK_API_URL=https://demo-client.bhutanndi.com/webhook/v1
NDI_REQUEST_TIMEOUT_MS=10000

# Webhook registration: the id you registered with NDI and the bearer token
# (min 32 chars) NDI sends to POST /api/ndi/webhook.
NDI_WEBHOOK_ID=
NDI_WEBHOOK_TOKEN=

# Default proof request (used when a partner doesn't send its own).
NDI_DEFAULT_PROOF_NAME=Verify identity
NDI_DEFAULT_PROOF_ATTRIBUTES=[{"name":"Full Name","restrictions":[{"schema_name":"https://dev-schema.ngotag.com/schemas/c7952a0a-e9b5-4a4b-a714-1e5d0a1ae076"}]},{"name":"ID Number","restrictions":[{"schema_name":"https://dev-schema.ngotag.com/schemas/c7952a0a-e9b5-4a4b-a714-1e5d0a1ae076"}]}]

# --- Partners ---------------------------------------------------------------
# JSON array. `name` is shown to users; `redirectOrigins` are the only places
# users can be sent back to. Generate keys with: openssl rand -base64 36
PARTNERS=[{"id":"local","name":"Local test partner","apiKey":"dev-partner-key-change-me-0000000000","redirectOrigins":["http://localhost:3000"]}]

# --- Timing (seconds) -------------------------------------------------------
PROOF_TTL_SECONDS=300
APPROVAL_TIMEOUT_SECONDS=120
SESSION_TTL_SECONDS=1800

# --- Rate limits (per minute) -----------------------------------------------
RATE_LIMIT_CREATE_PER_MINUTE=120
RATE_LIMIT_PROOF_PER_MINUTE=20

# --- Public (baked into the client bundle at build time) --------------------
NEXT_PUBLIC_SUPPORT_EMAIL=ndifeedback@bhutanndi.bt
NEXT_PUBLIC_SUPPORT_PHONE=1199
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/search?q=bhutan%20ndi
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/search?term=bhutan%20ndi
# "Watch video guide" link in the support section (hidden when empty).
NEXT_PUBLIC_VIDEO_GUIDE_URL=

# --- Language (read at run time; restart the server to apply) --------------
# Show the EN / Dzongkha switch. When false, every page is in English.
ENABLE_LANGUAGE_TOGGLE=true
